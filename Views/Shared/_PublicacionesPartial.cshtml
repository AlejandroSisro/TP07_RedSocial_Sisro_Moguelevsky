@model List<TP07_RedSocial_Sisro_Moguelevsky.Models.Publicacion>

@if (Model == null || Model.Count == 0)
{
    <div class="empty-state">
        <p>No hay publicaciones para mostrar.</p>
    </div>
}

@foreach (var publicacion in Model)
{
    var usuarioActualId = Context.Session.GetInt32("UsuarioId");
    var botonTexto = publicacion.TieneLike ? "Quitar Me Gusta" : "Me Gusta";
    var botonClase = publicacion.TieneLike ? "btn btn-sm btn-outline-danger" : "btn btn-sm btn-outline-primary";

    <article class="publication-card card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">@publicacion.Titulo</h5>
                    <small class="text-muted">@publicacion.NombreUsuario</small>
                </div>
                <small class="text-muted">@publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            <img src="@publicacion.Imagen" alt="@publicacion.Titulo" class="publication-image" onerror="this.src='/uploads/default-post.jpg';" />

            <p class="mt-3 mb-3">@publicacion.Descripcion</p>

            <div class="d-flex align-items-center gap-2 mb-3">
                <button type="button"
                        class="@botonClase"
                        data-like-btn="true"
                        data-publicacion-id="@publicacion.Id">
                    @botonTexto
                </button>
                <span class="likes-count" data-like-count="@publicacion.Id">@publicacion.CantidadLikes me gusta</span>
            </div>

            <div class="comments-box">
                <h6>Comentarios</h6>
                <ul class="list-unstyled mb-3" id="comentarios-@publicacion.Id">
                    @if (publicacion.Comentarios != null)
                    {
                        foreach (var comentario in publicacion.Comentarios)
                        {
                            <li class="comment-item">
                                <strong>@comentario.NombreUsuario:</strong>
                                <span>@comentario.Texto</span>
                            </li>
                        }
                    }
                </ul>

                <form class="comment-form" data-comment-form="true" data-publicacion-id="@publicacion.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <textarea name="texto" class="form-control" rows="2" placeholder="Escribí un comentario..."></textarea>
                        <button type="submit" class="btn btn-primary">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </article>
}
